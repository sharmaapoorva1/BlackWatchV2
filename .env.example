# Postgres connection string used by the BlackWatch app.
DATABASE_URL=postgresql://blackwatch:blackwatch@localhost:5432/blackwatch

# Comma-separated token:module pairs. The token a source presents in the
# X-BlackWatch-Token header determines which module its events are stamped with.
# Unmapped modules fall back to the generic passthrough adapter.
BLACKWATCH_TOKENS=devtoken:generic,vpntoken:vpn.openvpn

# Phase 2 direct EC2 agent ingress. Keep real values out of Git; map each
# instance ID to its own token in the production environment.
# BLACKWATCH_AGENT_TOKENS=i-0123456789abcdef0:replace-with-agent-token
# BLACKWATCH_AGENT_INGRESS_DIR=/app/data/agent-ingress

# Optional default account/tenant stamped on events when a source omits it.
# BLACKWATCH_ACCOUNT=

# Optional IP intelligence credentials. Leave these blank to use the no-key
# path (ip-api.com, local feeds, DNS/RDAP, anonymous GreyNoise where allowed,
# and Certificate Transparency). These values are read only by the UI server;
# they are never sent to the browser or stored in BlackWatch data tables.
# GREYNOISE_API_KEY=
# ABUSEIPDB_API_KEY=
# VIRUSTOTAL_API_KEY=
